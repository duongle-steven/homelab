// Renovate (platform/renovate, docs/how-to-guides/renovate.md): pull requests into dev, labelled sandbox so the
// sandbox runs before a merge; nothing merges automatically
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  baseBranchPatterns: ['dev'],
  labels: ['sandbox'],
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 5am on monday'],
  },
  // app-template values files (apps/*.yaml) besides the default values*.yaml
  'helm-values': {
    managerFilePatterns: ['/^apps/[^/]+\\.ya?ml$/'],
  },
  nix: {
    enabled: true,
  },
  customManagers: [
    {
      // The app-template chart pinned in the apps ApplicationSet (restated in values-dev.yaml and values-seed.yaml)
      customType: 'regex',
      managerFilePatterns: ['/^system/argocd/values(-[a-z]+)?\\.yaml$/'],
      matchStrings: ['repoURL: (?<registryUrl>https://\\S+)\\s+chart: (?<depName>\\S+)\\s+targetRevision: (?<currentValue>\\d\\S*)'],
      datasourceTemplate: 'helm',
    },
    {
      // The sandbox's k3s (the one Kubernetes version the tests run; production's k3s comes with step 12)
      customType: 'regex',
      managerFilePatterns: ['/^infra/_modules/k3d/k3d\\.yaml$/'],
      matchStrings: ['image: (?<depName>rancher/k3s):(?<currentValue>\\S+)'],
      datasourceTemplate: 'docker',
      versioningTemplate: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-k3s(?<build>\\d+)$',
    },
    {
      // The Gateway API CRDs the sandbox installs (k3s's packaged ones are disabled)
      customType: 'regex',
      managerFilePatterns: ['/^infra/_modules/k3d/main\\.tf$/'],
      matchStrings: ['variable "gateway_api_version" \\{\\s+type\\s+= string\\s+default\\s+= "(?<currentValue>v[^"]+)"'],
      depNameTemplate: 'kubernetes-sigs/gateway-api',
      datasourceTemplate: 'github-releases',
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'all non-major dependencies',
      groupSlug: 'all-minor-patch',
    },
  ],
}
