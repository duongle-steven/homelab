#!/bin/sh
# What the sandbox workflow runs after a push to dev (.github/workflows/sandbox.yaml): prints "scope=full" (the make dev
# argument) unless every change since <before> is skipped (test/scopes.yaml), nothing then. A failing selector fails
# the script: an error must never read as "nothing to test". A new branch (forty zeros) runs the whole suite.
set -eu
before=${1:?usage: sandbox-scope <previous commit>}
if [ "$before" = 0000000000000000000000000000000000000000 ]; then
	echo scope=full
	exit 0
fi
cd "$(git rev-parse --show-toplevel)"
lab() {
	if [ -n "${SANDBOX_LAB:-}" ]; then "$SANDBOX_LAB" "$@"; else go -C cli run ./cmd/lab "$@"; fi
}
# Captured first: set -e ignores a failure inside a command substitution in a test
main=$(lab test scope --base "$before")
alone=$(lab test scope --base "$before" --alone)
if [ -n "$main$alone" ]; then
	echo scope=full
fi
