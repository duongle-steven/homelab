#!/bin/sh
# The basic checks, one per name, as GitHub Actions runs them (.github/workflows/checks.yaml) and as the workstation
# runs them before a commit (scripts/ci-check all); several names run each. Run in the dev shell (nix develop). render renders the charts
# changed since $BASE (default origin/dev; lab test charts).
set -eu
cd "$(git rev-parse --show-toplevel)"
checks='render go cli infra docs mesh backup-groups rotation-catalog catalog crds backstage env-config secret-stores lint leaks iac images policy workflows'

check() {
	case "$1" in
		render)
			targets=$(go -C cli run ./cmd/lab test charts --base "${BASE:-origin/dev}")
			for t in $targets; do
				echo "render $t"
				scripts/render-chart "$t" >/dev/null
				scripts/render-chart "$t" dev >/dev/null
			done ;;
		# The offline tests are test/offline and test/internal's packages (test/e2e holds the cluster tests, which go vet
		# compiles). -count=1: the offline tests run scripts and just, whose files go test's cache does not see; -timeout 20m: they take close to go test's default 10 minutes on a busy workstation
		go) (cd test && unformatted=$(gofmt -l .) && { [ -z "$unformatted" ] || { echo "gofmt: $unformatted" >&2; exit 1; }; } &&
			go vet ./... && go test -count=1 -timeout 20m ./offline/... ./internal/...) ;;
		cli) just cli::test cli::check ;;
		infra) env -u HOMELAB_STATE_PASSPHRASE just infra check ;;
		docs) mkdocs build --strict ;;
		mesh) scripts/check-mesh-policies ;;
		backup-groups) scripts/check-backup-groups ;;
		rotation-catalog) go -C cli run ./cmd/lab secrets check --root "$PWD" ;;
		# Backstage's catalog and homepage's services, generated from each app's and component's description
		catalog) go -C cli run ./cmd/lab catalog check ;;
		# system/crds against the components' charts: a bumped chart needs scripts/vendor-crds <component>
		crds) scripts/vendor-crds --check ;;
		# backstage/'s own checks (types, lint, unit tests), only when the branch changes it
		backstage)
			if git diff --quiet "${BASE:-origin/dev}...HEAD" -- backstage && git diff --quiet HEAD -- backstage; then
				echo "backstage: unchanged"
			else
				(cd backstage && yarn install --immutable && yarn tsc && yarn lint:all && CI=true yarn test:all)
			fi ;;
		env-config) scripts/check-env-config ;;
		secret-stores) scripts/check-secret-stores ;;
		lint) scripts/lint ;;
		leaks) BASE="${BASE:-origin/dev}" scripts/check-leaks ;;
		iac) scripts/check-iac ;;
		images) BASE="${BASE:-origin/dev}" scripts/check-images ;;
		policy) scripts/check-policy ;;
		workflows) scripts/check-workflows ;;
		*) echo "ci-check: unknown check $1 (one of: $checks, all)" >&2; exit 2 ;;
	esac
}

# One or more checks, or all; each named check runs (a second name was once ignored silently)
: "${1:?usage: ci-check <check>...|all}"
if [ "$1" = all ]; then
	# shellcheck disable=SC2086 # one check per word
	set -- $checks
fi
for c in "$@"; do
	[ $# = 1 ] || echo "== $c"
	check "$c"
done
