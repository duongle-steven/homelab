#!/bin/sh
# Trust testbed's host keys on first contact (only on the workstation's own libvirt network), waiting for each node's
# SSH: VMs just started are still booting.
# Usage: testbed-trust <hosts.json>
set -eu
wait_seconds=${TESTBED_TRUST_WAIT:-300}
interval=${TESTBED_TRUST_INTERVAL:-5}
for ip in $(jq -r '.[].ip' "$1"); do
	deadline=$(($(date +%s) + wait_seconds))
	until ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=10 "admin@$ip" true 2>/dev/null; do
		if [ "$(date +%s)" -ge "$deadline" ]; then
			echo "testbed-trust: no SSH from $ip after ${wait_seconds}s" >&2
			exit 1
		fi
		sleep "$interval"
	done
done
