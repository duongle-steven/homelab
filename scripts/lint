#!/bin/sh
# yamllint, shellcheck on every tracked shell script (first line a sh or bash shebang) and actionlint on the
# GitHub Actions workflows; a basic check (scripts/ci-check lint)
set -eu
cd "$(git rev-parse --show-toplevel)"
# Tracked files only: make dev writes git-ignored YAML (kubeconfigs, CRD downloads) that is not ours to lint
git ls-files -z '*.yaml' '*.yml' | xargs -0 yamllint -s
# Every tracked file whose first line is a sh or bash shebang, NUL-separated so any path works
# shellcheck disable=SC2016 # the inner script expands its own "$f"
git ls-files -z | xargs -0 sh -c 'for f do
	if [ -f "$f" ] && head -n 1 "$f" | grep -qE "^#!.*[/ ](ba)?sh( |$)"; then printf "%s\0" "$f"; fi
done' sh | xargs -0 -r shellcheck
if [ -d .github/workflows ]; then actionlint; fi
