#!/bin/sh
# yamllint, shellcheck on every tracked shell script (first line a sh or bash shebang) and actionlint on the
# GitHub Actions workflows; a basic check (scripts/ci-check lint)
set -eu
cd "$(git rev-parse --show-toplevel)"
yamllint -s .
scripts=$(git ls-files | while IFS= read -r f; do
	if [ -f "$f" ] && head -n 1 "$f" | grep -qE '^#!.*[/ ](ba)?sh( |$)'; then echo "$f"; fi
done)
# One path per line; tracked paths here have no spaces
# shellcheck disable=SC2086
shellcheck $scripts
if [ -d .github/workflows ]; then actionlint; fi
