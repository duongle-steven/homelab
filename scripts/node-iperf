#!/bin/sh
# What WireGuard costs the network between nodes (G12, docs/superpowers/specs/2026-11-26-lan-encryption-design.md),
# where Ceph's replication and every pod's traffic to another node run: iperf3 between two pods on the first two nodes
# of hosts.json, by pod IP (no Service, no mesh: the namespace is not Argo CD's), the same job every time: 30 s of TCP
# with 4 streams each way. Every node's CPU busy is sampled every 10 s over SSH while it runs. Prints the throughput
# each way and each node's average CPU, then deletes its namespace and waits until it is gone. The gate for
# production, which runs no Ceph yet: ceph-fio measures the same path through Ceph where Ceph runs.
# Usage: node-iperf <testbed|production>
set -eu
env=${1:?usage: node-iperf <testbed|production>}
root="$(dirname "$0")/.."
export KUBECONFIG="$root/infra/$env/kubeconfig.yaml"
hosts="$root/infra/$env/metal/hosts.json"
ns=node-iperf
server=$(jq -r 'keys[0]' "$hosts")
client=$(jq -r 'keys[1]' "$hosts")
cleanup() {
	kubectl delete namespace "$ns" --ignore-not-found --wait=true --timeout=5m >/dev/null || true
}
trap cleanup EXIT
# Alpine's latest release and its iperf3, both pinned
image=docker.io/library/alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
install="apk add --no-cache -q iperf3=3.20-r0 >&2"
kubectl create namespace "$ns" --dry-run=client -o yaml | kubectl apply -f - >/dev/null
kubectl -n "$ns" apply -f - >/dev/null <<YAML
apiVersion: v1
kind: Pod
metadata: {name: server}
spec:
  nodeName: $server
  securityContext: {seccompProfile: {type: RuntimeDefault}}
  containers:
    - name: iperf
      image: $image
      securityContext: {allowPrivilegeEscalation: false}
      command: [sh, -c, "$install && exec iperf3 --server"]
      readinessProbe: {tcpSocket: {port: 5201}, periodSeconds: 2}
YAML
kubectl -n "$ns" wait pod/server --for=condition=Ready --timeout=5m >/dev/null
address=$(kubectl -n "$ns" get pod server -o jsonpath='{.status.podIP}')
kubectl -n "$ns" apply -f - >/dev/null <<YAML
apiVersion: batch/v1
kind: Job
metadata: {name: client}
spec:
  backoffLimit: 0
  template:
    spec:
      nodeName: $client
      restartPolicy: Never
      securityContext: {seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: iperf
          image: $image
          securityContext: {allowPrivilegeEscalation: false}
          command: [sh, -c]
          args:
            - >-
              $install &&
              iperf3 --client $address --time 30 --parallel 4 --json > /tmp/send.json &&
              iperf3 --client $address --time 30 --parallel 4 --reverse --json > /tmp/receive.json &&
              echo ---iperf-json--- && cat /tmp/send.json /tmp/receive.json
YAML
cpu=$(mktemp)
# Each node's busy share between two /proc/stat reads, every 10 s until the Job ends
while ! kubectl -n "$ns" get job client -o jsonpath='{.status.conditions[*].type}' | grep -qE 'Complete|Failed'; do
	for ip in $(jq -r '.[].ip' "$hosts"); do
		ssh -o BatchMode=yes "root@$ip" 'a=$(head -1 /proc/stat); sleep 5; b=$(head -1 /proc/stat); echo "$a|$b"' |
			awk -F'|' -v ip="$ip" '{ split($1, a, " "); split($2, b, " "); t = 0; for (i = 2; i <= 11; i++) t += b[i] - a[i]
				idle = (b[5] - a[5]) + (b[6] - a[6]); if (t > 0) print ip, 100 * (t - idle) / t }' >> "$cpu" &
	done
	wait
	sleep 5
done
kubectl -n "$ns" get job client -o jsonpath='{.status.conditions[*].type}' | grep -q Complete ||
	{ kubectl -n "$ns" logs job/client >&2; echo "node-iperf: the job failed" >&2; exit 1; }
# The logs hold apk's messages too: only what follows the marker is iperf3's JSON, one document per direction
kubectl -n "$ns" logs job/client | awk 'found; /^---iperf-json---$/ { found = 1 }' | jq -rs --arg c "$client" --arg s "$server" '
	(.[0].end.sum_received.bits_per_second / 1e6 | floor) as $send |
	(.[1].end.sum_received.bits_per_second / 1e6 | floor) as $receive |
	"\($c) -> \($s): \($send) Mbit/s, retransmits \(.[0].end.sum_sent.retransmits)",
	"\($s) -> \($c): \($receive) Mbit/s, retransmits \(.[1].end.sum_sent.retransmits)"'
awk '{ s[$1] += $2; n[$1]++ } END { for (ip in s) printf "%s: CPU busy %.0f%%\n", ip, s[ip] / n[ip] }' "$cpu" | sort
rm -f "$cpu"
