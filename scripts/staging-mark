#!/bin/sh
# Mark a commit as proved by staging: GitHub commit status "staging" (success), which lab infra forgejo verify looks for
# (docs/installation/staging.md). make staging runs it once every staging test passed; verify --skip-staging runs it
# with the skip's reason, so the release records why it went without staging. Uses gh's own login.
# Usage: scripts/staging-mark <commit> [description]
set -eu
commit=$(git rev-parse --verify "$1^{commit}")
description=${2:-"make staging passed"}
repository=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
gh api --silent "repos/$repository/statuses/$commit" -f state=success -f context=staging -f description="$description"
echo "staging-mark: $commit ($description)"
