#!/bin/sh
# nixie for staging (infra/staging/metal's hook; run in the node flake): usage staging-nixie <hosts.json> <nixie args>
# - nixie records what it installed (machine_id_hash) by rewriting its hosts file: that is state, so it works on a copy
#   in .state/staging/ (the repository's hosts.json, plus the hashes recorded for the same name and MAC)
# - scripts/staging-wake listens meanwhile, so nixie's Wake-on-LAN power-cycles each VM it installs once its PXE
#   server answers, as a powered-off machine would boot then
set -eu
root=$(git rev-parse --show-toplevel)
hosts=$1
shift
state="$root/.state/staging/metal/nixie-hosts.json"
mkdir -p "$(dirname "$state")"
[ -f "$state" ] || echo '{}' > "$state"
jq --slurpfile recorded "$state" 'with_entries(
	.value += (($recorded[0][.key] // {}) as $r | if $r.mac_address == .value.mac_address and $r.machine_id_hash
		then {machine_id_hash: $r.machine_id_hash} else {} end))' "$hosts" > "$state.new"
mv "$state.new" "$state"
sudo "$(command -v python3)" "$root/scripts/staging-wake" &
wake=$!
trap 'sudo kill "$wake" 2>/dev/null || true' EXIT
sudo "$(command -v nixie)" --hosts "$state" "$@"
