#!/bin/sh
# Builds lab's image from the checkout and puts it on the sandbox's node as homelab-lab:dev, the image
# platform/secrets-rotation's values-dev.yaml runs (production runs the one GitHub Actions builds from master with
# cli/Dockerfile). The binary is built here, from the local module cache, onto cli/Dockerfile's runtime image.
set -eu
cd "$(git rev-parse --show-toplevel)"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
CGO_ENABLED=0 GOOS=linux GOARCH="$(go env GOARCH)" go -C cli build -trimpath -ldflags=-s -o "$work/lab" ./cmd/lab
runtime=$(sed -n 's/^FROM \([^ ]*\)$/\1/p' cli/Dockerfile | tail -1)
printf 'FROM %s\nCOPY lab /lab\nENTRYPOINT ["/lab"]\n' "$runtime" > "$work/Dockerfile"
docker build --quiet -t homelab-lab:dev "$work" >/dev/null
k3d image import --cluster homelab-dev homelab-lab:dev
