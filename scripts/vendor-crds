#!/usr/bin/env bash
# Writes system/crds/files/<component>/<crd>.yaml (one file each: Helm caps a chart's files at 5 MB): the CustomResourceDefinitions of each component's pinned chart, which
# the components no longer install (docs/superpowers/specs/2026-11-20-sandbox-groups-design.md). The version is the
# component's own (its Chart.yaml): regenerate after any chart bump.
# Usage: scripts/vendor-crds [<component>...]  (all when none; a component is its directory's name)
#        scripts/vendor-crds --check             (exit 1 and name the stale ones)
set -euo pipefail
cd "$(dirname "$0")/.."

# component directory | the helm arguments that turn its chart's templated CRDs on (its values.yaml turns them off);
# charts that keep CRDs in crds/ need none (scripts/render-chart's HOMELAB_RENDER_CRDS=1)
COMPONENTS=(
  # trust-manager runs only in the sandbox and the testbed (values-local.yaml): enabled here so its CRD is vendored
  "system/cert-manager|--set cert-manager.crds.enabled=true --set trust-manager.enabled=true --set trust-manager.crds.enabled=true"
  "system/external-dns|"
  "system/istio-system|--set-json base.base.excludedCRDs=[]"
  "system/kyverno|--set kyverno.crds.install=true"
  "system/monitoring-system|--set kube-prometheus-stack.crds.enabled=true"
  "system/opentelemetry|--set opentelemetry-operator.crds.create=true"
  "system/rook-ceph|--set rook-ceph.crds.enabled=true --set snapshot-controller.installCRDs=true"
  "system/trivy-operator|"
  "system/velero|"
  "platform/argo-events|--set argo-events.crds.install=true"
  "platform/argo-workflows|--set argo-workflows.crds.install=true --set argo-workflows.crds.full=false"
  "platform/cloudnative-pg|--set cloudnative-pg.crds.create=true"
  "platform/external-secrets|--set external-secrets.installCRDs=true"
  "platform/kanidm|"
)

render() { # dir sets outdir -> writes outdir/<crd>.yaml for each of the component's CRDs, annotated
  local dir=$1 sets=$2 out=$3 version
  version=$(yq '[.dependencies[] | .name + " " + .version] | join(", ")' "$dir/Chart.yaml")
  rm -rf "$out" && mkdir -p "$out"
  set -- "$dir"
  # shellcheck disable=SC2086 # the table's arguments, split on spaces
  [ -n "$sets" ] && set -- "$@" "" $sets
  local all
  all=$(mktemp --suffix .yaml)
  local err
  err=$(mktemp)
  # Helm's chatter (dependency downloads) only when the render fails, naming the component
  if ! HOMELAB_RENDER_CRDS=1 scripts/render-chart "$@" 2>"$err" >"$all"; then
    echo "vendor-crds: rendering $dir failed:" >&2
    cat "$err" >&2
    rm -f "$err" "$all"
    exit 1
  fi
  rm -f "$err"
  # rook-ceph's ceph-csi-operator templates its csi.ceph.io CRDs with no switch: they stay with rook-ceph (never in the
  # sandbox), the one component that installs CRDs
  yq 'select(.kind == "CustomResourceDefinition" and .spec.group != "csi.ceph.io")
      | .metadata.annotations["argocd.argoproj.io/sync-options"] = "Prune=false,ServerSideApply=true"
      | del(.metadata.labels["helm.sh/chart"], .metadata.labels["app.kubernetes.io/managed-by"], .metadata.labels["app.kubernetes.io/instance"])' \
    -s "\"$out/\" + .metadata.name + \".yaml\"" "$all"
  rm "$all"
  for f in "$out"/*.yaml; do
    { echo "# Generated by scripts/vendor-crds from $dir ($version): do not edit"; cat "$f"; } >"$f.tmp" && mv "$f.tmp" "$f"
  done
}

check=
if [ "${1:-}" = --check ]; then check=1; shift; fi
stale=0
for entry in "${COMPONENTS[@]}"; do
  dir=${entry%%|*} sets=${entry#*|} name=$(basename "${entry%%|*}")
  if [ $# -gt 0 ] && ! printf '%s\n' "$@" | grep -qx "$name"; then continue; fi
  out=system/crds/files/$name
  if [ -n "$check" ]; then
    tmp=$(mktemp -d)
    render "$dir" "$sets" "$tmp/$name"
    if ! diff -rq "$tmp/$name" "$out" >/dev/null 2>&1; then
      echo "vendor-crds: $out does not match $dir's chart: run scripts/vendor-crds $name" >&2
      stale=1
    fi
    rm -r "$tmp"
  else
    render "$dir" "$sets" "$out"
    echo "vendor-crds: $out ($(find "$out" -name '*.yaml' | wc -l) CRDs)"
  fi
done
exit $stale
