#!/bin/sh
# Print the values Argo CD passes from the environment's config file (infra/<env>/cluster/config.json) through the
# ApplicationSet <appset>'s helm.valuesObject, as name=value lines, so offline renders match the cluster's.
# Usage: scripts/env-values <prod|dev|testbed> <root|apps>
set -eu
env="$1"
appset="$2"
argocd=system/argocd
# The sandbox and testbed restate generators and the apps source in values-<env>.yaml
pick() {
  if [ "$env" != prod ] && [ -f "$argocd/values-$env.yaml" ] && [ "$(yq "explode(.) | $1" "$argocd/values-$env.yaml")" != null ]; then
    yq "explode(.) | $1" "$argocd/values-$env.yaml"
  else
    yq "explode(.) | $1" "$argocd/values.yaml"
  fi
}
base=".argocd-apps.applicationsets.$appset"
# The git generator reading config.json, at any matrix depth (step 14g wraps each matrix in a clusters generator)
config=$(pick "[$base.generators[0] | .. | select(has(\"pathParamPrefix\")) | .files[0].path][0]")
case "$appset" in
  root) object="$base.template.spec.sources[0].helm.valuesObject" ;;
  apps) object="$base.template.spec.sources[0].helm.valuesObject" ;;
esac
pick "$object" | yq '.. | select(tag == "!!str") | (path | join(".")) + "=" + .' | while IFS='=' read -r name value; do
  field=$(printf '%s' "$value" | sed -n 's/^{{ *\(\.[A-Za-z0-9_.]*\) *}}$/\1/p')
  case "$field" in
    # The cluster Secret's annotations (infra/_modules/argocd/cluster-secret.sh): offline, only the backup endpoint
    .metadata.annotations.backupS3Url) value=${BACKUP_S3_URL:-} ;;
    .metadata.annotations.*) echo "${field#.metadata.annotations.} is not an annotation env-values knows" >&2; exit 1 ;;
    ?*)
      value=$(yq -p json -o yaml "$field" "$config")
      [ "$value" != null ] || { echo "$config has no $field" >&2; exit 1; } ;;
  esac
  printf '%s=%s\n' "$name" "$value"
done
