#!/bin/sh
# Refuses to run the sandbox and staging together (12 GB of WSL hold one of them: docs/installation/staging.md) or
# with C: nearly full (WSL crashes when its virtual disk on C: cannot grow). Usage: staging-guard staging|dev
set -eu
case "${1:?usage: staging-guard staging|dev}" in
	staging)
		if [ "$(docker inspect -f '{{.State.Running}}' k3d-homelab-dev-server-0 2>/dev/null)" = true ]; then
			echo "make staging: the sandbox runs (k3d-homelab-dev-server-0): stop it first (k3d cluster stop homelab-dev)" >&2
			exit 1
		fi ;;
	dev)
		hosts="$(git rev-parse --show-toplevel)/infra/staging/metal/hosts.json"
		running=$(virsh -c qemu:///system list --name --state-running 2>/dev/null || true)
		if [ -n "$running" ] && printf '%s\n' "$running" | grep -qxF "$(jq -r 'keys[]' "$hosts")"; then
			echo "make dev: staging's VMs run: stop them first (make staging-stop)" >&2
			exit 1
		fi ;;
	*) echo "usage: staging-guard staging|dev" >&2; exit 2 ;;
esac
if [ -d /mnt/c ]; then
	free=$(df --output=avail -BG /mnt/c | tail -1 | tr -dc 0-9)
	if [ "$free" -lt 30 ]; then
		echo "C: has ${free} GB free: keep 30 GB (WSL's virtual disk lives there)" >&2
		exit 1
	fi
fi
