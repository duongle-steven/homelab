#!/bin/sh
# What WireGuard costs Ceph (G12, docs/superpowers/specs/2026-11-26-lan-encryption-design.md): fio from a pod on a
# 2Gi volume of the default class (Ceph's RBD), the same job every time: 1 GiB written then read in 1 MiB blocks, then
# 4 KiB random reads and writes for 60 s, all direct. Every node's CPU busy is sampled every 10 s over SSH while it runs.
# Prints the throughput, the IOPS and each node's average CPU, then deletes its namespace and waits until it is gone (a
# terminating namespace would stop the next just testbed at testbed-leftovers).
# Usage: ceph-fio <testbed|production>
set -eu
env=${1:?usage: ceph-fio <testbed|production>}
root="$(dirname "$0")/.."
export KUBECONFIG="$root/infra/$env/kubeconfig.yaml"
hosts="$root/infra/$env/metal/hosts.json"
ns=ceph-fio
cleanup() {
	kubectl delete namespace "$ns" --ignore-not-found --wait=true --timeout=5m >/dev/null || true
}
trap cleanup EXIT
kubectl create namespace "$ns" --dry-run=client -o yaml | kubectl apply -f - >/dev/null
kubectl -n "$ns" apply -f - >/dev/null <<YAML
apiVersion: v1
kind: PersistentVolumeClaim
metadata: {name: fio, labels: {homelab/backup: none}}
spec: {accessModes: [ReadWriteOnce], resources: {requests: {storage: 2Gi}}}
---
apiVersion: batch/v1
kind: Job
metadata: {name: fio}
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      securityContext: {seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: fio
          # Alpine's latest release and its fio, both pinned
          image: docker.io/library/alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
          securityContext: {allowPrivilegeEscalation: false}
          command: [sh, -c]
          args:
            - >-
              apk add --no-cache -q fio=3.41-r0 >&2 &&
              cd /data &&
              fio --output-format=json --output=/tmp/fio.json --direct=1 --ioengine=libaio --filename=fio.dat --size=1G
              --name=seq-write --rw=write --bs=1M --iodepth=16
              --name=seq-read --stonewall --rw=read --bs=1M --iodepth=16
              --name=rand-rw --stonewall --rw=randrw --bs=4k --iodepth=32 --time_based --runtime=60 &&
              echo ---fio-json--- && cat /tmp/fio.json
          volumeMounts: [{name: data, mountPath: /data}]
      volumes: [{name: data, persistentVolumeClaim: {claimName: fio}}]
YAML
cpu=$(mktemp)
# Each node's busy share between two /proc/stat reads, every 10 s until the Job ends
while ! kubectl -n "$ns" get job fio -o jsonpath='{.status.conditions[*].type}' | grep -qE 'Complete|Failed'; do
	for ip in $(jq -r '.[].ip' "$hosts"); do
		ssh -o BatchMode=yes "root@$ip" 'a=$(head -1 /proc/stat); sleep 5; b=$(head -1 /proc/stat); echo "$a|$b"' |
			awk -F'|' -v ip="$ip" '{ split($1, a, " "); split($2, b, " "); t = 0; for (i = 2; i <= 11; i++) t += b[i] - a[i]
				idle = (b[5] - a[5]) + (b[6] - a[6]); if (t > 0) print ip, 100 * (t - idle) / t }' >> "$cpu" &
	done
	wait
	sleep 5
done
kubectl -n "$ns" get job fio -o jsonpath='{.status.conditions[*].type}' | grep -q Complete ||
	{ kubectl -n "$ns" logs job/fio >&2; echo "ceph-fio: the job failed" >&2; exit 1; }
# The logs hold apk's and fio's own messages too: only what follows the marker is fio's JSON
kubectl -n "$ns" logs job/fio | sed '1,/^---fio-json---$/d' | jq -r '.jobs[] | "\(.jobname): read \(.read.bw / 1024 | floor) MiB/s \(.read.iops | floor) IOPS, write \(.write.bw / 1024 | floor) MiB/s \(.write.iops | floor) IOPS"'
awk '{ s[$1] += $2; n[$1]++ } END { for (ip in s) printf "%s: CPU busy %.0f%%\n", ip, s[ip] / n[ip] }' "$cpu" | sort
rm -f "$cpu"
