#!/usr/bin/env python3
"""Every ExternalSecret reads OpenBao through its namespace's SecretStore, inside its namespace's branch.

Renders every component and app file in production and the sandbox (scripts/render-chart) and fails on:
- an ExternalSecret that reads anything but SecretStore openbao (system/secret-store), also per item (sourceRef), or
  sits in a namespace system/secret-store excludes (no SecretStore there);
- a key outside secret/<namespace>/, where the namespace is the component's (Argo CD's destination);
- a PushSecret outside platform/global-secrets, or through any store but its openbao-writer;
- a push outside secret/<namespace>/generated/ (the writer's only paths), a push nobody reads, or a read of
  <namespace>/generated/ that nothing pushes;
- any ClusterSecretStore.
ExternalSecrets that only run generators (platform/global-secrets) read no store.
"""

import glob
import os
import re
import subprocess
import sys
import time

import yaml


class Loader(yaml.SafeLoader):
    """SafeLoader that reads a bare `=` (YAML 1.1's value tag, used by some charts) as a string."""


Loader.add_constructor("tag:yaml.org,2002:value", lambda loader, node: loader.construct_scalar(node))

WRITER = ("platform/global-secrets", "openbao-writer")
GENERATED = re.compile(r"[^/]+/generated/[^/]+")
EXCLUDE = yaml.safe_load(open("system/secret-store/values.yaml"))["exclude"]


def render(target, env):
    # Chart downloads sometimes reset the connection: try three times
    for attempt in range(3):
        out = subprocess.run(["scripts/render-chart", target, env], capture_output=True, text=True)
        if out.returncode == 0:
            return [d for d in yaml.load_all(out.stdout, Loader=Loader) if d]
        time.sleep(5)
    sys.exit(f"render failed: {target} {env}\n{out.stderr}")


def targets():
    dirs = sorted(glob.glob("system/*/") + glob.glob("platform/*/") + glob.glob("apps/*/"))
    return [d.rstrip("/") for d in dirs if glob.glob(d + "Chart.yaml")] + sorted(glob.glob("apps/*.yaml"))


def stores(spec):
    """Every store an ExternalSecret reads: its own and any item's sourceRef.storeRef."""
    if not generators_only(spec):
        ref = spec.get("secretStoreRef") or {}
        yield ref.get("kind", "SecretStore"), ref.get("name")
    for item in (spec.get("data") or []) + (spec.get("dataFrom") or []):
        ref = (item.get("sourceRef") or {}).get("storeRef")
        if ref:
            yield ref.get("kind", "SecretStore"), ref.get("name")


def keys(spec):
    for item in spec.get("data") or []:
        yield item["remoteRef"]["key"]
    for item in spec.get("dataFrom") or []:
        if "extract" in item:
            yield item["extract"]["key"]
        elif "find" in item:
            yield None  # find searches the whole store: never allowed


def generators_only(spec):
    sources = spec.get("dataFrom") or []
    return not spec.get("data") and sources and all("generatorRef" in (s.get("sourceRef") or {}) for s in sources)


def main():
    failures = []
    pushed, read = {}, {}  # key -> where
    for env in ("prod", "dev"):
        for target in targets():
            for doc in render(target, env):
                kind, meta = doc.get("kind"), doc.get("metadata") or {}
                namespace = meta.get("namespace") or os.path.basename(target).removesuffix(".yaml")
                spec = doc.get("spec") or {}
                where = f"{target} ({env}): {kind}/{meta.get('name')}"
                if kind == "ClusterSecretStore":
                    failures.append(f"{where}: use the namespace's SecretStore openbao (system/secret-store)")
                elif kind == "ExternalSecret":
                    if generators_only(spec):
                        continue
                    if namespace in EXCLUDE:
                        failures.append(f"{where}: namespace {namespace} has no SecretStore (system/secret-store excludes it)")
                    for store in set(stores(spec)):
                        if store != ("SecretStore", "openbao"):
                            failures.append(f"{where}: reads {store[0]}/{store[1]}, not SecretStore/openbao")
                    for key in keys(spec):
                        if key is None or not key.startswith(namespace + "/"):
                            failures.append(f"{where}: key {key} is outside its branch {namespace}/")
                        else:
                            read.setdefault(key, where)
                elif kind == "PushSecret":
                    refs = [(r.get("kind", "SecretStore"), r.get("name")) for r in spec.get("secretStoreRefs") or []]
                    if (target, refs) != (WRITER[0], [("SecretStore", WRITER[1])]):
                        failures.append(f"{where}: only {WRITER[0]} pushes, through SecretStore {WRITER[1]}")
                    for item in spec.get("data") or []:
                        key = item["match"]["remoteRef"]["remoteKey"]
                        if not GENERATED.fullmatch(key):
                            failures.append(f"{where}: pushes {key}, outside <namespace>/generated/ (the writer's paths)")
                        pushed.setdefault(key, where)
    for key, where in sorted(pushed.items()):
        if key not in read:
            failures.append(f"{where}: pushes {key}, which no ExternalSecret in namespace {key.split('/')[0]} reads")
    for key, where in sorted(read.items()):
        if GENERATED.fullmatch(key) and key not in pushed:
            failures.append(f"{where}: reads {key}, which platform/global-secrets does not push")
    for f in failures:
        print(f, file=sys.stderr)
    print(f"check-secret-stores: {len(failures)} failures")
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
