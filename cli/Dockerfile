# lab for the scheduled rotation (platform/secrets-rotation): GitHub Actions builds it from master
# (.github/workflows/lab-image.yaml), the sandbox locally (scripts/build-lab-image)
FROM docker.io/library/golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags=-s -o /lab ./cmd/lab

FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
COPY --from=build /lab /lab
ENTRYPOINT ["/lab"]
