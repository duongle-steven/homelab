use flake
# Cloudflare token for infra/<env>/cloudflare (outside the repository; docs/installation/production/external-resources.md)
source_env_if_exists ~/.config/homelab/cloudflare.env
# OpenTofu's state passphrase (outside the repository; docs/installation/production/external-resources.md)
source_env_if_exists ~/.config/homelab/state.env
